# Wysyłka formularza kontaktowego (resend.com)
# 1. Załóż konto, dodaj domenę kliqa.pl i potwierdź rekordy SPF/DKIM w DNS.
# 2. Wygeneruj klucz API i wklej poniżej.
RESEND_API_KEY=

# Odbiorca zgłoszeń z formularza.
CONTACT_TO=biuro@kliqa.pl

# Nadawca — musi należeć do domeny zweryfikowanej w Resend.
CONTACT_FROM=formularz@kliqa.pl

# Analityka (etap 3): identyfikator kontenera Google Tag Manager.
NEXT_PUBLIC_GTM_ID=
