# Kliqa — konfiguracja serwera (Apache / LiteSpeed, hosting SeoHost)
# Plik trafia do katalogu domeny: domains/kliqa.pl/public_html/.htaccess
#
# UWAGA: w tym katalogu stoi także WordPress z WooCommerce. Ten plik zawiera
# ZARÓWNO reguły WordPressa, JAK I ustawienia nowego serwisu — jeśli usuniesz
# blok WordPressa, przestaną działać linki bezpośrednie sklepu (produkty, kategorie,
# wpisy zaczną zwracać 404).
#
# Nowy serwis żyje w katalogach: /uslugi/, /o-nas/, /edukacja/, /kontakt/, /assets/.
# WordPress obsługuje resztę, łącznie ze stroną główną. Rozdział działa dlatego,
# że reguła WordPressa przepuszcza istniejące pliki i katalogi (!-f, !-d).

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS — certyfikat wystaw w DirectAdmin (Let's Encrypt) PRZED włączeniem tej reguły
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. jeden kanoniczny adres: bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# BEGIN WordPress
# Standardowy blok WordPressa. Istniejące pliki i katalogi (czyli podstrony nowego
# serwisu) są przepuszczane; cała reszta trafia do index.php.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  # HSTS włącz dopiero, gdy HTTPS działa stabilnie przez kilka dni:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML bez cache — po każdym wdrożeniu użytkownik ma dostać nową wersję
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/plain "access plus 7 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>

# Dane terenu to zwykły tekst base64 — właściwy typ i długi cache
<FilesMatch "terrain\.b64\.txt$">
  ForceType text/plain
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>
