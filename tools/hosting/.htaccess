# Kliqa — konfiguracja serwera (Apache / LiteSpeed, hosting SeoHost)
# Plik trafia do katalogu domeny: domains/kliqa.pl/public_html/.htaccess

Options -Indexes -MultiViews

# Adresy podstron kończą się ukośnikiem: /uslugi/ , /edukacja/consent-mode-v2/
# Tak serwuje je serwer bez żadnych sztuczek — katalog + index.html. Wcześniejsza
# próba trzymania adresów bez ukośnika wchodziła w konflikt z DirectorySlash
# i kończyła się pętlą przekierowań, więc kanoniczna jest wersja z ukośnikiem.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS — certyfikat wystaw w DirectAdmin (Let's Encrypt) PRZED włączeniem tej reguły
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. jeden kanoniczny adres: bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Nieznany adres pokazuje stronę główną (aplikacja i tak obsłuży trasę)
ErrorDocument 404 /index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  # HSTS włącz dopiero, gdy HTTPS działa stabilnie przez kilka dni:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML bez cache — po każdym wdrożeniu użytkownik ma dostać nową wersję
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/plain "access plus 7 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>

<FilesMatch "\.(html)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Dane terenu to zwykły tekst base64 — niech serwer poda właściwy typ i pozwoli je scachować
<FilesMatch "terrain\.b64\.txt$">
  ForceType text/plain
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>

# Nic poza katalogiem publicznym nie powinno być czytelne
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
