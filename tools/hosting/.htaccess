# Kliqa — konfiguracja serwera (Apache / LiteSpeed, hosting SeoHost)
# Plik trafia do katalogu domeny: domains/kliqa.pl/public_html/.htaccess
#
# W tym katalogu leżą jeszcze pliki starego WordPressa. Serwis Kliqa go ignoruje:
# strona główna to nasz index.html, a adresy, których nie ma w naszym serwisie,
# pokazują naszą stronę główną — nie stronę WordPressa.
# Panel /wp-admin/ nadal działa (to zwykły katalog), więc dostęp do starej instalacji
# pozostaje, gdyby trzeba było coś z niej wyciągnąć.

Options -Indexes

# Nasz index.html ma pierwszeństwo przed index.php WordPressa
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS — certyfikat wystaw w DirectAdmin (Let's Encrypt) PRZED włączeniem tej reguły
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. jeden kanoniczny adres: bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Nieznany adres dostaje własną stronę błędu — z kodem 404, żeby wyszukiwarki
# usunęły z indeksu stare adresy WordPressa zamiast widzieć pod nimi kopię strony głównej.
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# --- reguły WordPressa (wyłączone) ---
# Odkomentuj cały blok, jeśli stary WordPress ma znów obsługiwać swoje adresy
# (wpisy, produkty, kategorie). Nasze podstrony i tak działają, bo są zwykłymi
# katalogami z plikiem index.html i reguła je przepuszcza.
#
# <IfModule mod_rewrite.c>
# RewriteEngine On
# RewriteBase /
# RewriteRule ^index\.php$ - [L]
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule . /index.php [L]
# </IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  # HSTS włącz dopiero, gdy HTTPS działa stabilnie przez kilka dni:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML bez cache — po każdym wdrożeniu użytkownik ma dostać nową wersję
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/plain "access plus 7 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

# Kroje pisma i wspólny skrypt są niezmienne w obrębie wersji: skrypt ma w adresie
# skrót treści, a nazwa pliku kroju zmieni się razem z krojem. Rok w pamięci podręcznej
# oznacza, że przy drugim i każdym kolejnym wejściu nie ma po nie ani jednego zapytania.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
<FilesMatch "\.(woff2|ico)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>
<FilesMatch "^kliqa\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# Dane terenu to zwykły tekst base64 — właściwy typ i długi cache
<FilesMatch "terrain\.b64\.txt$">
  ForceType text/plain
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>
